generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String
  plan      String   @default("free") // free, pro, business
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  usages    Usage[]
}

model Usage {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  type           String   // transcription, translation, tts, podcast
  durationSeconds Int     @default(0)
  creditsUsed    Int      @default(1) // 1 credit = 1 minute of audio
  inputChars     Int      @default(0)
  metadata       String?  // JSON string for extra info
  createdAt      DateTime @default(now())

  @@index([userId, createdAt])
}
