{
  "name": "vocaleez",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Vocaleez — outil local open-source de transcription, traduction, synthèse vocale (TTS), podcast multi-voix et génération de couverture. Mono-utilisateur, auto-hébergé.",
  "license": "MIT",
  "keywords": [
    "transcription",
    "translation",
    "text-to-speech",
    "whisper",
    "podcast",
    "tts",
    "self-hosted",
    "local-first"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emdiakhate/harmony-voice.git"
  },
  "homepage": "https://github.com/emdiakhate/harmony-voice#readme",
  "bugs": {
    "url": "https://github.com/emdiakhate/harmony-voice/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "concurrently -n client,server -c cyan,green \"vite\" \"tsx watch server/index.ts\"",
    "predev": "prisma db push",
    "start": "vite build && tsx server/index.ts",
    "prestart": "prisma db push",
    "dev:client": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "setup:piper": "bash scripts/setup-piper.sh",
    "setup:piper:win": "powershell -ExecutionPolicy Bypass -File scripts/setup-piper.ps1"
  },
  "dependencies": {
    "@elevenlabs/elevenlabs-js": "^2.36.0",
    "@hookform/resolvers": "^3.10.0",
    "@prisma/adapter-better-sqlite3": "^7.4.2",
