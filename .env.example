# ===== AI Provider Keys =====

# Optional: OpenAI API key (used for TTS and optionally for translation/Whisper)
OPENAI_API_KEY=sk-...

# Optional: Groq API key (if set, used for Whisper transcription + translation — faster and cheaper)
# Priority: Groq > OpenRouter > OpenAI for LLM tasks
GROQ_API_KEY=gsk_...

# Optional: OpenRouter API key (fallback for translation/LLM when Groq is unavailable)
OPENROUTER_API_KEY=sk-or-...

# Optional: ElevenLabs API key (TTS fallback when OpenAI quota is exhausted)
ELEVENLABS_API_KEY=sk_...

# Optional: Google API key (for Gemini multi-speaker podcast TTS)
GOOGLE_API_KEY=...

# ===== Auth (Clerk) =====
# Get your keys at https://dashboard.clerk.com
# If not set, auth is disabled (dev mode — no login required)

CLERK_SECRET_KEY=sk_test_...
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# ===== Database =====

DATABASE_URL=file:./prisma/dev.db

# ===== Server =====

PORT=3001
