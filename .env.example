# ===== Clés des fournisseurs IA (TOUTES optionnelles) =====
# Deux façons d'ajouter vos clés :
#   1) directement dans l'interface (Paramètres) — elles sont chiffrées et stockées en local ;
#   2) ici dans .env — sert de repli.
# Sans aucune clé, la traduction fonctionne quand même via des fournisseurs gratuits
# (Pollinations, LLM7). La transcription (Whisper) nécessite une clé Groq ou OpenAI.

# OpenAI — transcription (Whisper), traduction, TTS
OPENAI_API_KEY=

# Groq — transcription Whisper + traduction (rapide)
GROQ_API_KEY=

# OpenRouter — repli traduction / LLM
OPENROUTER_API_KEY=

# ElevenLabs — synthèse vocale premium
ELEVENLABS_API_KEY=

# Google — Gemini (traduction + TTS podcast multi-voix)
GOOGLE_API_KEY=

# ===== Optionnel =====

# Base SQLite (le défaut convient)
# DATABASE_URL=file:./prisma/dev.db

# Port du serveur (défaut : 3001)
# PORT=3001

# Clé de chiffrement des clés stockées en base : générée automatiquement au
# 1er lancement (fichier .encryption-key). Ne la définissez que pour la fixer.
# ENCRYPTION_KEY=
